   "source": [
    "cadena = input(\"Ingrese una cadena: \")\n",
    "\n",
    "cadena_limpia = cadena.replace(\" \", \"\").lower()\n",
    "\n",
    "cadena_invertida = cadena_limpia[::-1]\n",
    "\n",
    "if cadena_limpia == cadena_invertida:\n",
    "    print(f\"'{cadena}' es un palíndromo\")\n",
    "else:\n",
    "    print(f\"'{cadena}' no es un palíndromo\")\n"
   ]
  }
